{
  "name": "loup-garou",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node --watch server/index.mjs",
    "bot": "node --watch server/telegram.mjs",
    "start": "node server/index.mjs",
    "db": "docker compose up -d postgres",
    "cluster": "docker compose up --build --scale api=3",
    "dev:cluster": "VITE_API_PROXY=http://127.0.0.1:8080 vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
